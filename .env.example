POSTGRES_USER=jotanunes
POSTGRES_PASSWORD=senha-local
POSTGRES_DB=JotaNunesFormsDb

# JWT local de desenvolvimento: use somente em Development; nunca reutilize em produção.
# Defina uma chave aleatória com pelo menos 32 bytes no ambiente, sem commitá-la.
# Jwt__Issuer=JotaNunesForms
# Jwt__Audience=JotaNunesForms
# Jwt__SigningKey=
# Jwt__ExpirationMinutes=480
# Cors__Origins=http://localhost:5173

# Bootstrap de produção é opt-in e create-only. Configure estes campos no secret manager,
# habilite temporariamente e desabilite-os após a criação do primeiro Admin.
# BootstrapAdmin__Enabled=false
# BootstrapAdmin__Documento=
# BootstrapAdmin__NomeExibicao=
# BootstrapAdmin__Password=

# ClickUp (opcional — sync backlog; ver docs/clickup/login-e-api.md)
# CLICKUP_API_TOKEN=
# CLICKUP_LIST_ID=
